# Skopiuj do .env i zmien. docker-compose odmowi startu bez kodu zaproszenia.
JOBWATCH_INVITE=wymysl-wlasny-kod

# Klucz szyfrujacy CV i profile w bazie. Wygeneruj RAZ:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Zrob kopie w menedzerze hasel. Bez niego zaszyfrowane profile sa nie do odzyskania.
JOBWATCH_DB_KEY=

# 1 = cookie tylko po HTTPS (produkcja). 0 tylko do testow na localhoscie.
JOBWATCH_HTTPS=1

# Godzina dziennego przebiegu i ile ofert na scraper
JOBWATCH_RUN_HOUR=7
JOBWATCH_LIMIT=300
